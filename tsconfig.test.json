{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "outDir": "./.test-out",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "types": ["node"]
  },
  "include": [
    "src/model/types.ts",
    "src/parsers/**/*.ts",
    "src/serializers/**/*.ts",
    "webview/src/exportImage.ts",
    "webview/src/sdlTextLayout.ts",
    "webview/src/sdlTransform.ts",
    "webview/src/transform.ts",
    "webview/src/waypoints.ts",
    "test/**/*.ts"
  ],
  "exclude": ["node_modules"]
}