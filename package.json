{
  "name": "vscive",
  "displayName": "vscive",
  "description": "Interface View Editor",
  "version": "1.0.4",
  "publisher": "lurkerpas",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:vscive.interfaceViewEditor",
    "onCustomEditor:vscive.deploymentViewEditor",
    "onCustomEditor:vscive.sdlEditor",
    "onCommand:vscive.createIv",
    "onCommand:vscive.createDv",
    "onCommand:vscive.tasteInitHere",
    "onCommand:vscive.tasteBuildRelease",
    "onCommand:vscive.tasteBuildDebug",
    "onCommand:vscive.tasteBuildClean",
    "onCommand:vscive.tasteBuildDvRelease",
    "onCommand:vscive.tasteBuildDvDebug",
    "onCommand:vscive.tasteBuildSkeletons",
    "onCommand:vscive.tasteRun"
  ],
  "main": "./out/extension-node.js",
  "browser": "./out/extension-web.js",
  "contributes": {
    "commands": [
      {
        "command": "vscive.createIv",
        "title": "vscive: create iv"
      },
      {
        "command": "vscive.createDv",
        "title": "vscive: create dv"
      },
      {
        "command": "vscive.tasteInitHere",
        "title": "vscive: taste init here"
      },
      {
        "command": "vscive.tasteBuildRelease",
        "title": "vscive: taste build release"
      },
      {
        "command": "vscive.tasteBuildDebug",
        "title": "vscive: taste build debug"
      },
      {
        "command": "vscive.tasteBuildClean",
        "title": "vscive: taste build clean"
      },
      {
        "command": "vscive.tasteBuildDvRelease",
        "title": "vscive: taste build dv release"
      },
      {
        "command": "vscive.tasteBuildDvDebug",
        "title": "vscive: taste build dv debug"
      },
      {
        "command": "vscive.tasteBuildSkeletons",
        "title": "vscive: taste build skeletons"
      },
      {
        "command": "vscive.tasteRun",
        "title": "vscive: taste run"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "vscive.createIv",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "vscive.createDv",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "vscive.tasteInitHere",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "vscive.tasteBuildRelease",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "vscive.tasteBuildDebug",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "vscive.tasteBuildClean",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "vscive.tasteBuildDvRelease",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "vscive.tasteBuildDvDebug",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "vscive.tasteBuildSkeletons",
          "when": "explorerResourceIsFolder"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "vscive.interfaceViewEditor",
        "displayName": "Interface View Editor",
        "selector": [
          {
            "filenamePattern": "interfaceview.xml"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "vscive.deploymentViewEditor",
        "displayName": "Deployment View Editor",
        "selector": [
          {
            "filenamePattern": "*.dv.xml"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "vscive.sdlEditor",
        "displayName": "SDL Editor",
        "selector": [
          {
            "filenamePattern": "*.pr"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "VSCIVE",
      "properties": {
        "vscive.attributesFilePath": {
          "type": "string",
          "default": "",
          "description": "Path or URI to the Attributes file. On desktop, empty defaults to $HOME/.local/default_attributes.xml."
        },
        "vscive.boardsFilePath": {
          "type": "string",
          "default": "",
          "description": "Path or URI to the Boards file used by the Deployment View editor."
        },
        "vscive.useTasteCliShForCommands": {
          "type": "boolean",
          "default": false,
          "description": "Use taste-cli.sh to run Build and Build Skeletons commands instead of invoking make directly."
        },
        "vscive.useTasteCliBatForCommands": {
          "type": "boolean",
          "default": false,
          "description": "Use taste-cli.bat with podman to run Build and Build Skeletons commands instead of invoking make directly. Defaults to enabled at runtime on Windows when no value is stored."
        }
      }
    }
  },
  "scripts": {
    "build-tests": "node -e \"require('fs').rmSync('.test-out',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "compile": "npm run bundle-ext && npm run bundle-web && npm run compile-webview",
    "bundle-ext": "esbuild src/extension.ts --bundle --outfile=out/extension-node.js --external:vscode --platform=node --target=node18 --format=cjs --sourcemap",
    "bundle-web": "esbuild src/extension.ts --bundle --outfile=out/extension-web.js --external:vscode --platform=browser --target=es2020 --format=cjs --sourcemap",
    "check": "npm run typecheck && npm run test && npm run bundle-ext && npm run bundle-web && npm run compile-webview",
    "debug-web": "npm run bundle-web && npm run compile-webview",
    "test": "npm run build-tests && node --test --test-reporter=spec .test-out/test/*.test.js",
    "typecheck": "tsc -p ./ --noEmit",
    "compile-webview": "vite build",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension-node.js --external:vscode --platform=node --target=node18 --format=cjs --sourcemap --watch",
    "watch-web": "esbuild src/extension.ts --bundle --outfile=out/extension-web.js --external:vscode --platform=browser --target=es2020 --format=cjs --sourcemap --watch",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile",
    "lint": "eslint src"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vscive/vscive"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.90.0",
    "@types/xmldom": "^0.1.34",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vscode/vsce": "^2.32.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "@xyflow/react": "^12.10.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript-parsec": "^0.3.4"
  },
  "overrides": {
    "undici": "5"
  }
}
